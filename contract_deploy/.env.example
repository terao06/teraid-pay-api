# RPC endpoint for the target chain.
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key used only for deployment. Do not commit real values.
DEPLOYER_PRIVATE_KEY=0x...

# JPYC token address for the target chain.
JPYC_TOKEN_ADDRESS=0x...

# Optional. Defaults to the deployer address when omitted.
CONTRACT_OWNER_ADDRESS=0x...
PAYMENT_OPERATOR_ADDRESS=0x...

# Optional gas settings.
GAS_MULTIPLIER=1.2
MAX_PRIORITY_FEE_GWEI=2
